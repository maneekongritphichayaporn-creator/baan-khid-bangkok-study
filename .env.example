# The publishable key is safe to expose; database access is still controlled by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Local admin imports only. Add this to your private .env.local, never to Vercel.
# SUPABASE_SECRET_KEY=sb_secret_your-key
